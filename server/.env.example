# Environment Variables for Vendora Cloud API Server
# Copy this file to .env and fill in values before running.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── PostgreSQL ────────────────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=vendora_db
PG_USER=vendora_user
PG_PASSWORD=your_secure_password_here
PG_SSL=false                     # Set to true for AWS RDS / GCP Cloud SQL

# ── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_very_long_random_secret_here
JWT_EXPIRES_IN=7d

# ── Email Notifications (Nodemailer / Gmail) ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_app_password_here   # Use a Gmail App Password, not your main password
SMTP_FROM=Vendora POS <no-reply@vendora.app>
