{
  "name": "nafid",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "version": "2.2.89",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently --kill-others \"vite\" \"npm run build:electron && wait-on tcp:5173 && electron .\"",
    "dev:debug": "concurrently --kill-others \"vite\" \"npm run build:electron && wait-on tcp:5173 && electron --remote-debugging-port=9222 .\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "tsc -b && vite build && npm run build:electron",
    "rebuild": "node scripts/fix-sqlite.js",
    "package": "npm run rebuild && npm run build && electron-builder build --config electron-builder.config.js --win --publish always -c.electronDist=node_modules/electron/dist",
    "package:win": "npm run rebuild && npm run build && electron-builder build --config electron-builder.config.js --win -c.electronDist=node_modules/electron/dist",
    "package:mac": "node scripts/prepare-macos-runtime.cjs && npm run build && electron-builder build --config electron-builder.config.js --mac --publish never",
    "package:all": "npm run rebuild && npm run build && electron-builder build --config electron-builder.config.js --win --mac",
    "lint": "eslint .",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "lint:unused": "npx --yes knip@5 --include files,exports,dependencies,devDependencies,unlisted,duplicates",
    "lint:baseline": "node scripts/lint-ratchet.mjs --update",
    "check:arch": "node scripts/check-architecture.mjs",
    "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "tsc -b && npm run typecheck:electron && npm run test && npm run check:arch",
    "preview": "vite preview"
  },
  "dependencies": {
    "@keyv/serialize": "^1.1.1",
    "@types/papaparse": "^5.5.2",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "12.11.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.3",
    "lucide-react": "^1.14.0",
    "papaparse": "^5.7.0",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-barcode": "^1.6.1",
    "react-dom": "^19.2.5",
    "recharts": "3.8.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.13"
  },
  "optionalDependencies": {
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.12.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/serialport": "^8.0.5",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^42.4.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "26.1.0",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.2.2",
    "vitest": "^3.2.7",
    "wait-on": "^9.0.5"
  }
}
