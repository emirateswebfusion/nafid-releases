{
  "name": "nafid",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "version": "1.5.60",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently --kill-others \"vite\" \"pnpm run build:electron && wait-on tcp:5173 && electron .\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "tsc -b && vite build && npm run build:electron",
    "package": "npm run build && electron-builder build --config electron-builder.config.js --win --publish always",
    "package:win": "npm run build && electron-builder build --config electron-builder.config.js --win",
    "package:mac": "npm run build && electron-builder build --config electron-builder.config.js --mac",
    "package:all": "npm run build && electron-builder build --config electron-builder.config.js --win --mac",
    "rebuild": "electron-rebuild",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.3",
    "lucide-react": "^1.14.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-barcode": "^1.6.1",
    "react-dom": "^19.2.5",
    "recharts": "3.8.1",
    "sql.js": "^1.14.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.0",
    "zustand": "^5.0.13"
  },
  "optionalDependencies": {
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.12.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/serialport": "^8.0.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "electron": "^42.4.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.2.2",
    "wait-on": "^9.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "@serialport/bindings-cpp"
    ]
  }
}
