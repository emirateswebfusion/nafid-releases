      -moz-osx-font-smoothing: grayscale;
      text-rendering: optimizeLegibility;
      width: 210mm;
      max-width: 210mm;
    }
    .bill-container {
      width: 100%;
      max-width: 198mm;
      min-height: 136mm;
      max-height: 142mm;
      box-sizing: border-box;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
