{
  "bos/boxed": "<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>ESTIMATE - POS1-104</title>
  <style>
    * { box-sizing: border-box; }
    html, body {
      height: 100%;
      margin: 0;
      padding: 0;
    }
    @page {
      size: A4 portrait;
      margin: 6mm 8mm;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      font-size: 10.5px;
      color: #000;
      background: #fff;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      text-rendering: optimizeLegibility;
    }
    .invoice-box {
      width: 100%;
      height: 282mm;
      border: 1.5px solid #000;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-sizing: border-box;
    }
    .header-table {
      width: 100%;
      border-collapse: collapse;
      border-bottom: 1px solid #000;
    }
    .header-table td {
      vertical-align: top;
      padding: 5px 8px;
      font-size: 10.5px;
      line-height: 1.35;
    }
    .shop-title {
      font-size: 17px;
      font-weight: 900;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      margin-bottom: 2px;
    }
    .grid-2col {
      display: flex;
      border-bottom: 1px solid #000;
    }
    .grid-col {
      width: 50%;
      padding: 4px 8px;
      font-size: 10.5px;
      line-height: 1.4;
    }
    .grid-col.left {
      border-right: 1px solid #000;
    }
    .table-container {
      flex: 1 1 auto;
      display: flex;
      flex-direction: column;
      min-height: 0;
    }
    .items-table {
      width: 100%;
      height: 100%;
      border-collapse: collapse;
      table-layout: fixed;
    }
    .items-table tbody {
      height: 100%;
    }
    .items-table tr.fill-row {
      height: 100%;
    }
    .items-table th {
      font-size: 9.5px;
      font-weight: bold;
      background: #fff;
      vertical-align: middle;
      border-right: 1px solid #000;
      border-bottom: 1px solid #000;
    }
    .items-table th:last-child {
      border-right: 1px solid #000;
    }
    .items-table td {
      font-size: 10px;
      vertical-align: middle;
    }
    .items-table td:last-child {
      border-right: 1px solid #000;
    }
    .footer-container {
      margin-top: auto;
      page-break-inside: avoid;
      break-inside: avoid;
    }
    @media print {
      body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .invoice-box {
        height: 282mm;
      }
      .footer-container {
        page-break-inside: avoid;
        break-inside: avoid;
      }
    }
  </style>
</head>
<body>
  <div class="invoice-box">
    <!-- Top Header -->
    <table class="header-table">
      <tr>
        <td style="width: 32%;">
