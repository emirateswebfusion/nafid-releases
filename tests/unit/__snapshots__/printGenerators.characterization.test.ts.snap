  "bos/classic": "<!DOCTYPE html>
<html><head><meta charset="utf-8"><meta name="page-size" content="A4"><meta name="page-orientation" content="portrait"><title>ESTIMATE - Corner Store</title>
<style>
  @page { size: A4; margin: 15mm; }
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 12px; color: #1a1a1a; padding: 0; margin: 0; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; text-rendering: optimizeLegibility; }
  .outer-box { border: 2px double #333; padding: 20px; }
  .header { text-align: center; margin-bottom: 15px; border-bottom: 2px solid #333; padding-bottom: 12px; }
  .header h1 { font-size: 24px; margin: 0; letter-spacing: 3px; font-weight: 700; }
  .header p { font-size: 11px; color: #555; margin: 2px 0; }
  .invoice-title { font-size: 18px; font-weight: bold; text-align: center; margin: 12px 0; letter-spacing: 4px; color: #1a1a1a; }
  .info-table { width: 100%; margin-bottom: 18px; font-size: 11px; }
  .info-table td { padding: 2px 4px; vertical-align: top; }
  .info-table .lbl { font-weight: 600; color: #555; }
  table.items { width: 100%; border-collapse: collapse; margin: 12px 0; }
  table.items tfoot { display: table-row-group; page-break-inside: avoid; break-inside: avoid; }
  table.items th { background: #e5e7eb; padding: 7px 6px; border: 1px solid #9ca3af; font-size: 10px; text-transform: uppercase; letter-spacing: 1px; font-weight: 700; text-align: left; }
  table.items td { padding: 5px 6px; border: 1px solid #9ca3af; font-size: 11px; }
  table.items tfoot td { font-weight: bold; border-top: 2px solid #333; }
  .grand-total td { font-size: 13px; font-weight: bold; }
  .text-right { text-align: right; }
  .text-center { text-align: center; }
  .discount-badge { font-size: 9px; color: #b91c1c; font-style: italic; }
  .terms { margin-top: 22px; padding-top: 10px; border-top: 1px solid #333; font-size: 13px; color: #1a1a1a; line-height: 1.5; }
  .terms strong { color: #000; font-size: 13.5px; }
  .footer { text-align: center; font-size: 9px; color: #777; margin-top: 20px; border-top: 1px solid #ccc; padding-top: 8px; font-style: italic; }
  .upi-box { text-align:center; margin-top: 12px; padding: 6px; border: 1px dashed #9ca3af; }
  .upi-box p { font-size: 11px; margin: 0; }
  @media print { body { -webkit-print-color-adjust: exact; print-color-adjust: exact; } table.items th { background: #e5e7eb !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; } }
</style></head><body>
  <div class="outer-box">
    <div class="header">
      <h1>Corner Store</h1>
      <p>Market Road</p>
      <p>Phone: 9000000001</p>
      
      
    </div>
  <div class="invoice-title">— ESTIMATE —</div>

    <table class="info-table">
      <tr>
        <td style="width:50%">
          <span class="lbl">Invoice No:</span> POS1-104<br>
          <span class="lbl">Date:</span> 2026-10-03T12:15:00Z<br>
          <span class="lbl">Biller:</span> Staff One<br>
        </td>
        <td style="width:50%;text-align:right">
          <span class="lbl">Customer:</span> Ravi Kumar<br>
          
          <span class="lbl">Phone:</span> 9876543210<br>
          
          
        </td>
      </tr>
    </table>

    

    <table class="items">
      <thead><tr>
        <th style="width:32px;text-align:center">#</th>
        <th>Particulars</th>
        <th style="width:75px;text-align:right">Rate</th><th style="width:55px;text-align:center">Qty</th>
        <th style="width:85px;text-align:right">Amount</th>
      </tr></thead>
      <tbody>
    <tr>
      <td style="padding:5px 6px;border:1px solid #d1d5db;font-size:11px;text-align:center">1</td>
      <td style="padding:5px 6px;border:1px solid #d1d5db;font-size:11px">Paint 1L</td>
      <td style="padding:5px 6px;border:1px solid #d1d5db;font-size:11px;text-align:right">₹250.00</td><td style="padding:5px 6px;border:1px solid #d1d5db;font-size:11px;text-align:center">3</td>
      <td style="padding:5px 6px;border:1px solid #d1d5db;font-size:11px;text-align:right">₹750.00</td>
    </tr>
  
    <tr>
      <td style="padding:5px 6px;border:1px solid #d1d5db;font-size:11px;text-align:center">2</td>
      <td style="padding:5px 6px;border:1px solid #d1d5db;font-size:11px">Brush<br><span style="font-size:9px;color:#b91c1c;font-style:italic">Offer (was ₹50.00)</span></td>
      <td style="padding:5px 6px;border:1px solid #d1d5db;font-size:11px;text-align:right">₹45.50</td><td style="padding:5px 6px;border:1px solid #d1d5db;font-size:11px;text-align:center">1</td>
      <td style="padding:5px 6px;border:1px solid #d1d5db;font-size:11px;text-align:right">₹45.50</td>
    </tr>
  </tbody>
      <tfoot>
        <tr><td colspan="4" class="text-right">Subtotal</td><td class="text-right">₹795.50</td></tr>
        
        
        
        <tr><td colspan="4" class="text-right">Discount</td><td class="text-right" style="color:#b91c1c">-₹20.00</td></tr>
        <tr class="grand-total"><td colspan="4" class="text-right">Grand Total</td><td class="text-right">₹775.50</td></tr>
        
        
        
        
        <tr><td style="padding-right: 10px; font-weight: bold;">Received</td><td style="font-weight: bold;">:</td><td style="text-align: right; padding-left: 10px; font-weight: bold;">₹500.00</td></tr>
      </tfoot>
    </table>

    

    

    
    
    
    <div style="margin-top: 20px; display: flex; justify-content: flex-end;">
      <div style="text-align: right; font-size: 11px;">
        <div style="font-weight: bold; text-transform: uppercase;">For CORNER STORE</div>
        
        <div style="height: 35px;"></div>
        <div style="font-weight: bold;">Authorised Signatory</div>
        
      </div>
    </div>
    
    <div class="footer">This is a computer generated invoice — Generated by Nafid on 15/10/2026, 4:00:00 pm</div>
  </div>
</body></html>",
  "bos/half-a4": "<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="page-size" content="half-a4">
  <meta name="page-orientation" content="portrait">
  <title>ESTIMATE - POS1-104</title>
  <style>
