    </table>

    
    <div style="margin-bottom: 12px; padding: 6px 10px; border: 1px solid #333; font-size: 11px; display: flex; flex-wrap: wrap; gap: 12px; justify-content: space-between;">
      
      <div>
        <strong>Transporter / E-Way:</strong>
