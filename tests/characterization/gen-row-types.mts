// Generates src/data/dbRows.ts: one interface per local SQLite table, from the schema initDb() creates.
// Run after any schema change (new migration):
//   EQ_USERDATA=<fresh dir> npx tsx gen-row-types.mts <tree> <out file>
// Columns are typed by SQLite affinity (INTEGER / REAL / NUMERIC -> number, everything else -> string) and allow null
// unless declared NOT NULL or part of the primary key.
import fs from 'node:fs';
import { pathToFileURL } from 'node:url';
import path from 'node:path';

const [tree, out] = process.argv.slice(2);
console.log = () => {}; console.warn = () => {};
const { initDb, getDb } = await import(pathToFileURL(path.join(tree, 'electron/db/localDb.ts')).href);
initDb();
const db = getDb();

const pascal = (s: string) => s.split('_').map((p) => p.charAt(0).toUpperCase() + p.slice(1)).join('');
const tsType = (declared: string) => {
  const t = (declared || '').toUpperCase();
  if (/INT|REAL|FLOA|DOUB|NUMERIC|DECIMAL|BOOL/.test(t)) return 'number';
  return 'string';
};

const tables = (db.prepare("SELECT name FROM sqlite_master WHERE type = 'table' AND name NOT LIKE 'sqlite_%' ORDER BY name").all() as { name: string }[])
  .map((r) => r.name);
let text = '// GENERATED by tests/characterization/gen-row-types.mts from the local SQLite schema. Do not edit by hand.\n'
  + '// One interface per table: what `SELECT * FROM <table>` returns. Queries that join extra columns extend these.\n';
for (const t of tables) {
  const cols = db.prepare(`PRAGMA table_info("${t}")`).all() as { name: string; type: string; notnull: number; pk: number }[];
  text += `\n/** Row of \`${t}\`. */\nexport interface ${pascal(t)}Row {\n`;
  for (const c of cols) {
    const nullable = !(c.notnull || c.pk);
    text += `  ${/^[A-Za-z_$][\w$]*$/.test(c.name) ? c.name : JSON.stringify(c.name)}: ${tsType(c.type)}${nullable ? ' | null' : ''};\n`;
  }
  text += '}\n';
}
fs.writeFileSync(out, text);
process.stderr.write(`${tables.length} tables written to ${out}\n`);
process.exit(0);
