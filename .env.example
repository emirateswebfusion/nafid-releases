# Copy to .env (development) or .env.production (packaging) and fill in. Never commit real values.
# Cloud API base URL (nafid-server)
VITE_CLOUD_API=
# Optional: main-process override of the cloud URL
VENDORA_CLOUD_API=
# Fallback sync interval in minutes
VENDORA_SYNC_INTERVAL_MINUTES=2
# LAN sync defaults (optional)
DEFAULT_LAN_IP=
DEFAULT_DNS=
# Release publishing only — keep out of any file that ships with the app
GH_TOKEN=
GITHUB_REPO_URL=
# Set to true to simulate a weighing scale (development only)
MOCK_SCALE=
